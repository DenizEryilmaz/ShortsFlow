# ShortsFlow Configuration Example
# Copy to .env and adjust paths for your local machine.

# Server bind address
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8010

# Local data directory (projects, assets, SQLite database, rendered jobs)
# STUDIO_DATA_DIR=./data

# Local OpenAI-compatible LLM server (e.g., Ollama)
STUDIO_LLM_BASE_URL=http://127.0.0.1:11434/v1
STUDIO_LLM_MODEL=qwen3-vl:8b-instruct

# Local ComfyUI server (for FLUX.2 [klein] 4B, LTX-Video, Qwen-Image)
STUDIO_COMFY_URL=http://127.0.0.1:8188
# STUDIO_COMFY_ROOT=../ComfyUI-local

# Optional local FreeVideo engine root (for MiniMax H3)
# STUDIO_FREEVIDEO_ROOT=../FreeVideo-local

# Optional explicit path to external Piper TTS CLI executable
# STUDIO_PIPER_BIN=piper

# Optional FreeVideo speed tuning (step cache & base steps 4..16)
# STUDIO_FREEVIDEO_STEP_CACHE=easycache-av
# STUDIO_FREEVIDEO_BASE_STEPS=6

# Optional external Lip-Sync CLI command for Dialogue shots (e.g., MuseTalk / LivePortrait wrapper)
# Placeholders: {image} {audio} {output} {width} {height} {duration}
# STUDIO_LIPSYNC_CMD=python /path/to/musetalk_cli.py --image "{image}" --audio "{audio}" --out "{output}"
